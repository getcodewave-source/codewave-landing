---
const steps = [
  {
    number: '01',
    title: 'Аналіз',
    description: 'Занурюємось у ваш бізнес: цілі, аудиторія, конкуренти. Разом будуємо чітке технічне завдання без води.',
    tags: ['Бриф', 'Аналіз ринку', 'ТЗ'],
    accent: ['#2563EB', '#3B82F6'],
  },
  {
    number: '02',
    title: 'Дизайн',
    description: 'Проєктуємо зручний UI/UX що відображає ваш бренд. Погоджуємо прототип до першого рядка коду.',
    tags: ['Прототип', 'UI/UX', 'Адаптив'],
    accent: ['#3B82F6', '#06B6D4'],
  },
  {
    number: '03',
    title: 'Розробка',
    description: 'Пишемо чистий, масштабований код. Регулярні демо кожні 1-2 тижні — бачите прогрес у реальному часі.',
    tags: ['Frontend', 'Backend', 'Code review'],
    accent: ['#06B6D4', '#2563EB'],
  },
  {
    number: '04',
    title: 'Запуск',
    description: 'Деплоїмо, налаштовуємо аналітику і залишаємося поруч. Жоден баг не залишається без уваги після релізу.',
    tags: ['Deploy', 'Моніторинг', 'Підтримка'],
    accent: ['#2563EB', '#06B6D4'],
  },
];
---

<section id="process" class="section-padding relative overflow-hidden" style="background:#080E1A;">

  <!-- Ambient glow -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute left-0 top-1/2 -translate-y-1/2 w-[500px] h-[500px] rounded-full opacity-[0.05]"
         style="background:radial-gradient(circle,#2563EB,transparent);filter:blur(80px);"></div>
    <div class="absolute right-0 top-1/2 -translate-y-1/2 w-[400px] h-[400px] rounded-full opacity-[0.04]"
         style="background:radial-gradient(circle,#06B6D4,transparent);filter:blur(80px);"></div>
  </div>

  <div class="max-w-6xl mx-auto px-6 relative z-10">

    <!-- Header -->
    <div class="mb-16 gsap-reveal">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div>
          <div class="tag-pill mb-5">Як ми працюємо</div>
          <h2 class="font-display font-bold text-4xl md:text-5xl text-white">
            Від ідеї до <span class="gradient-text">запуску</span>
          </h2>
        </div>
        <p class="text-brand-gray text-base max-w-xs leading-relaxed md:text-right">
          Чіткий процес без сюрпризів&nbsp;—<br class="hidden md:block"/> ви в курсі кожного кроку.
        </p>
      </div>
    </div>

    <!-- Gradient divider -->
    <div class="gradient-line mb-2"></div>

    <!-- Steps as editorial rows -->
    <div id="process-rows">
      {steps.map((step, i) => (
        <div
          class="process-row group relative"
          style="opacity:0;transform:translateY(30px);"
        >
          <!-- Gradient left border on hover -->
          <div
            class="absolute left-0 top-0 bottom-0 w-[2px] rounded-full scale-y-0 group-hover:scale-y-100 origin-top transition-transform duration-500"
            style={`background:linear-gradient(180deg,${step.accent[0]},${step.accent[1]});`}
          ></div>

          <!-- Row -->
          <div class="flex items-start lg:items-center gap-4 lg:gap-10 py-6 px-5 lg:py-7 lg:pl-10 transition-all duration-400 group-hover:bg-white/[0.025] rounded-xl">

            <!-- Big number -->
            <div
              class="font-display font-bold leading-none select-none flex-shrink-0 transition-opacity duration-400 opacity-60 group-hover:opacity-100 lg:opacity-20"
              style={`font-size:clamp(2rem,4vw,3.5rem);background:linear-gradient(135deg,${step.accent[0]},${step.accent[1]});-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;`}
            >
              {step.number}
            </div>

            <!-- Thin vertical separator — desktop only -->
            <div class="w-px self-stretch flex-shrink-0 transition-colors duration-400 hidden lg:block"
                 style="background:rgba(255,255,255,0.07);min-height:48px;"></div>

            <!-- Title + description -->
            <div class="flex-1 min-w-0">
              <h3 class="font-display font-semibold text-xl lg:text-2xl text-white mb-1.5 group-hover:gradient-text transition-all duration-300">
                {step.title}
              </h3>
              <p class="text-brand-gray text-sm leading-relaxed max-w-xl">{step.description}</p>
              <!-- Tags — mobile only (inside content block) -->
              <div class="flex items-center gap-1.5 flex-wrap mt-3 lg:hidden">
                {step.tags.map((tag) => (
                  <span class="text-xs font-medium rounded-full px-2.5 py-1" style="border:1px solid rgba(255,255,255,0.09);color:rgba(100,116,139,0.8);background:rgba(255,255,255,0.03);">{tag}</span>
                ))}
              </div>
            </div>

            <!-- Tags — desktop only -->
            <div class="hidden lg:flex items-center gap-2 flex-shrink-0">
              {step.tags.map((tag) => (
                <span
                  class="text-xs font-medium rounded-full px-3.5 py-1.5 transition-all duration-300"
                  style="border:1px solid rgba(255,255,255,0.07);color:rgba(100,116,139,1);background:rgba(255,255,255,0.02);"
                >
                  {tag}
                </span>
              ))}
            </div>

            <!-- Arrow icon — desktop only -->
            <div class="hidden lg:flex flex-shrink-0 w-8 h-8 rounded-full items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300"
                 style="background:rgba(37,99,235,0.12);border:1px solid rgba(37,99,235,0.2);">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"
                   style="color:#06B6D4;">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </div>
          </div>

          <!-- Bottom divider (not last) -->
          <div class="gradient-line opacity-30"></div>
        </div>
      ))}
    </div>

  </div>
</section>

<script is:inline>
  gsap.to('.process-row', {
    opacity: 1,
    y: 0,
    duration: 0.65,
    stagger: 0.14,
    ease: 'power3.out',
    scrollTrigger: {
      trigger: '#process-rows',
      start: 'top 80%',
    },
  });
</script>
