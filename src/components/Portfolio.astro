---

<section id="why-us" class="section-padding relative overflow-hidden" style="background:var(--bg-1);">

  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[400px] pointer-events-none opacity-[0.04]"
       style="background:radial-gradient(ellipse,#2563EB,transparent);filter:blur(80px);"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">

    <!-- Header -->
    <div class="text-center mb-16 gsap-reveal">
      <div class="tag-pill mb-5">Чому обирають нас</div>
      <h2 class="font-display font-bold text-4xl md:text-5xl text-white mb-5">
        Ваш надійний <span class="gradient-text">IT-партнер</span>
      </h2>
      <p class="text-brand-gray text-lg max-w-xl mx-auto leading-relaxed">
        Будуємо довгострокові відносини на основі компетентності, відповідальності та відкритої комунікації.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {advantages.map((adv) => (
        <div class="advantage-card group rounded-2xl p-7 relative overflow-hidden transition-all duration-300"
             style="opacity:0;transform:translateY(35px);background:var(--surface);border:1px solid var(--border);">

          <!-- Top accent line -->
          <div class="absolute top-0 left-0 right-0 h-[2px] opacity-0 group-hover:opacity-100 transition-opacity duration-300"
               style={`background:linear-gradient(90deg,${adv.color},transparent);`}></div>

          <!-- Icon -->
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-5 transition-transform duration-300 group-hover:scale-110"
               style={`background:${adv.color}15;border:1px solid ${adv.color}35;`}>
            <svg class="w-6 h-6" style={`color:${adv.color};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={adv.icon}></svg>
          </div>

          <!-- Content -->
          <h3 class="font-display font-bold text-lg text-white mb-3 leading-snug group-hover:gradient-text transition-all duration-300">
            {adv.title}
          </h3>
          <p class="text-brand-gray text-sm leading-relaxed">
            {adv.description}
          </p>

          <!-- Corner glow -->
          <div class="absolute bottom-0 right-0 w-24 h-24 rounded-full pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500"
               style={`background:radial-gradient(circle,${adv.color}12,transparent);filter:blur(20px);`}></div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-14 gsap-reveal">
      <a href="#contact" class="btn-primary inline-flex">
        <span>Розпочати співпрацю</span>
        <svg class="w-4 h-4 relative z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<script is:inline>
  gsap.to('.advantage-card', {
    opacity: 1,
    y: 0,
    duration: 0.7,
    stagger: 0.1,
    ease: 'power3.out',
    scrollTrigger: {
      trigger: '#why-us',
      start: 'top 75%',
      once: true,
    },
  });
</script>
