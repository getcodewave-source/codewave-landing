---
const projects = [
  {
    title: 'ShopFlow — інтернет-магазин',
    category: 'Веб-додаток',
    description: 'Повноцінний інтернет-магазин з управлінням товарами, Stripe-оплатами та адмін-панеллю для невеликого бренду одягу.',
    tags: ['Next.js', 'Stripe', 'PostgreSQL'],
    gradient: 'linear-gradient(135deg, #2563EB 0%, #7C3AED 100%)',
    icon: `<svg fill="none" viewBox="0 0 48 48" stroke-width="1.2" stroke="rgba(255,255,255,0.7)"><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h3l2.68 13.39M10 30h28l4-16H9.68M16 38a2 2 0 100 4 2 2 0 000-4zm20 0a2 2 0 100 4 2 2 0 000-4z"/></svg>`,
  },
  {
    title: 'DataBoard — SaaS аналітика',
    category: 'Веб-додаток',
    description: 'Платформа аналітики в реальному часі з кастомними графіками, управлінням користувачами та інтеграцією оплат.',
    tags: ['React', 'Node.js', 'Chart.js'],
    gradient: 'linear-gradient(135deg, #06B6D4 0%, #2563EB 100%)',
    icon: `<svg fill="none" viewBox="0 0 48 48" stroke-width="1.2" stroke="rgba(255,255,255,0.7)"><rect x="4" y="28" width="8" height="16" rx="2"/><rect x="16" y="18" width="8" height="26" rx="2"/><rect x="28" y="8" width="8" height="36" rx="2"/><rect x="40" y="22" width="4" height="22" rx="2"/></svg>`,
  },
  {
    title: 'SaleBot — бот для продажів',
    category: 'Автоматизація',
    description: 'Telegram-бот для автоматизованої воронки продажів з CRM-інтеграцією, прийомом оплат та відстеженням лідів.',
    tags: ['Python', 'Telegram API', 'MongoDB'],
    gradient: 'linear-gradient(135deg, #059669 0%, #06B6D4 100%)',
    icon: `<svg fill="none" viewBox="0 0 48 48" stroke-width="1.2" stroke="rgba(255,255,255,0.7)"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10l32-6L34 42 22 32l-8 6V26L8 10z"/><path stroke-linecap="round" stroke-linejoin="round" d="M22 32l6-9"/></svg>`,
  },
  {
    title: 'FitPro — лендінг для студії',
    category: 'Лендінг',
    description: 'Конверсійний лендінг із системою онлайн-запису та планами членства для преміум-фітнес-студії.',
    tags: ['Astro', 'Tailwind', 'GSAP'],
    gradient: 'linear-gradient(135deg, #DC2626 0%, #EA580C 100%)',
    icon: `<svg fill="none" viewBox="0 0 48 48" stroke-width="1.2" stroke="rgba(255,255,255,0.7)"><path stroke-linecap="round" stroke-linejoin="round" d="M6 24h4m28 0h4M14 24a10 10 0 0020 0M14 24a10 10 0 0120 0M10 16v16m28-16v16"/></svg>`,
  },
  {
    title: 'EstateHub — CRM для нерухомості',
    category: 'Веб-додаток',
    description: 'Система управління об\'єктами з автоматичними нагадуваннями клієнтам, генерацією документів та аналітикою.',
    tags: ['Vue.js', 'Laravel', 'MySQL'],
    gradient: 'linear-gradient(135deg, #7C3AED 0%, #EC4899 100%)',
    icon: `<svg fill="none" viewBox="0 0 48 48" stroke-width="1.2" stroke="rgba(255,255,255,0.7)"><path stroke-linecap="round" stroke-linejoin="round" d="M8 42V20L24 6l16 14v22H30V30h-12v12H8z"/></svg>`,
  },
  {
    title: 'MenuBot — бот для ресторану',
    category: 'Автоматизація',
    description: 'Telegram Mini App для замовлення їжі зі столів, системою бронювання, бонусами та сповіщеннями на кухню.',
    tags: ['Node.js', 'Telegram Mini App', 'Redis'],
    gradient: 'linear-gradient(135deg, #D97706 0%, #DC2626 100%)',
    icon: `<svg fill="none" viewBox="0 0 48 48" stroke-width="1.2" stroke="rgba(255,255,255,0.7)"><path stroke-linecap="round" stroke-linejoin="round" d="M8 42V12a2 2 0 012-2h28a2 2 0 012 2v30M4 42h40M18 22h12M18 30h8"/></svg>`,
  },
];

const categories = ['Всі', 'Веб-додаток', 'Лендінг', 'Автоматизація'];
---

<section id="portfolio" class="section-padding bg-brand-dark relative overflow-hidden">
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px] opacity-5 blur-[100px] rounded-full"
       style="background:radial-gradient(circle,#06B6D4,transparent)"></div>

  <div class="max-w-7xl mx-auto px-6">

    <div class="text-center mb-12 gsap-reveal">
      <div class="tag-pill mb-5">Наші роботи</div>
      <h2 class="font-display font-bold text-4xl md:text-5xl text-white mb-4">
        Вибрані <span class="gradient-text">проєкти</span>
      </h2>
      <p class="text-brand-gray text-lg max-w-xl mx-auto">
        Погляньте на те, що ми побудували для клієнтів з різних сфер бізнесу.
      </p>
    </div>

    <!-- Filter tabs -->
    <div class="flex flex-wrap justify-center gap-3 mb-12 gsap-reveal">
      {categories.map((cat, i) => (
        <button
          class={`filter-btn text-sm font-medium px-5 py-2 rounded-full border transition-all duration-200 ${
            i === 0
              ? 'border-brand-blue bg-brand-blue/20 text-white active'
              : 'border-white/10 bg-transparent text-brand-gray hover:border-brand-blue/40 hover:text-white'
          }`}
          data-filter={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="portfolio-grid">
      {projects.map((project) => (
        <div
          class="portfolio-card glass-card rounded-2xl overflow-hidden group cursor-pointer gsap-reveal"
          data-category={project.category}
        >
          <div
            class="h-48 flex items-center justify-center relative overflow-hidden"
            style={`background: ${project.gradient};`}
          >
            <div class="w-16 h-16 [&>svg]:w-full [&>svg]:h-full opacity-80 group-hover:scale-110 transition-transform duration-500"
                 set:html={project.icon}></div>
            <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
              <span class="text-white text-sm font-medium border border-white/40 rounded-full px-4 py-2">
                Детальніше
              </span>
            </div>
          </div>

          <div class="p-6">
            <div class="text-xs text-brand-cyan font-medium tracking-wide uppercase mb-2">{project.category}</div>
            <h3 class="font-display font-semibold text-lg text-white mb-2 group-hover:gradient-text transition-all duration-300">
              {project.title}
            </h3>
            <p class="text-brand-gray text-sm leading-relaxed mb-4">{project.description}</p>
            <div class="flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="text-xs text-brand-gray border border-white/10 rounded-full px-2.5 py-1">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-12 gsap-reveal">
      <a href="#contact" class="btn-secondary inline-flex">
        Обговорити ваш проєкт
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script is:inline>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.portfolio-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;

      filterBtns.forEach((b) => {
        b.classList.remove('border-brand-blue', 'bg-brand-blue/20', 'text-white', 'active');
        b.classList.add('border-white/10', 'text-brand-gray');
      });
      btn.classList.add('border-brand-blue', 'bg-brand-blue/20', 'text-white', 'active');
      btn.classList.remove('border-white/10', 'text-brand-gray');

      cards.forEach((card) => {
        const show = filter === 'Всі' || card.dataset.category === filter;
        gsap.to(card, {
          opacity: show ? 1 : 0.2,
          scale: show ? 1 : 0.97,
          duration: 0.35,
          ease: 'power2.out',
        });
        card.style.pointerEvents = show ? 'auto' : 'none';
      });
    });
  });
</script>
