---
const stats = [
  {
    value: 50,
    suffix: '+',
    label: 'Завершених проєктів',
    sub: 'від лендінгів до SaaS',
  },
  {
    value: 30,
    suffix: '+',
    label: 'Задоволених клієнтів',
    sub: 'по всій Україні',
  },
  {
    value: 100,
    suffix: '%',
    label: 'Задоволеність',
    sub: 'клієнти повертаються',
  },
  {
    value: 3,
    suffix: '+',
    label: 'Роки у розробці',
    sub: 'продовжуємо зростати',
  },
];
---

<section id="stats" class="relative overflow-hidden" style="background:var(--bg-1);">

  <!-- Top gradient line -->
  <div class="gradient-line"></div>

  <!-- Ambient center glow -->
  <div class="absolute inset-0 pointer-events-none flex items-center justify-center">
    <div class="w-[900px] h-[300px] rounded-full opacity-[0.07]"
         style="background:linear-gradient(90deg,#2563EB,#06B6D4);filter:blur(80px);"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 py-20 relative z-10">

    <!-- ── Desktop: горизонтальний ряд із роздільниками ── -->
    <div class="hidden md:grid md:grid-cols-4 divide-x divide-white/[0.06]" id="stats-grid">
      {stats.map((stat) => (
        <div class="stat-item px-8 lg:px-12 py-8 text-center group" data-target={stat.value} data-suffix={stat.suffix}>

          <!-- Micro label зверху -->
          <p class="text-brand-gray/60 text-xs tracking-[0.15em] uppercase mb-4 font-medium">
            {stat.sub}
          </p>

          <!-- Величезна цифра -->
          <div
            class="counter font-display font-bold leading-none mb-3 gradient-text"
            style="font-size:clamp(3.5rem,6vw,5.5rem);"
          >
            0{stat.suffix}
          </div>

          <!-- Label знизу -->
          <p class="text-white/70 text-sm font-medium tracking-wide">{stat.label}</p>

          <!-- Тонка лінія-акцент знизу — з'являється при hover -->
          <div class="mx-auto mt-5 h-px w-0 group-hover:w-16 transition-all duration-500 ease-out"
               style="background:linear-gradient(90deg,#2563EB,#06B6D4);"></div>
        </div>
      ))}
    </div>

    <!-- ── Mobile: 2×2 ── -->
    <div class="grid md:hidden grid-cols-2 gap-px" style="background:var(--surface-md);" id="stats-grid-mobile">
      {stats.map((stat) => (
        <div class="stat-item-mobile px-6 py-10 text-center" style="background:var(--bg-1);" data-target={stat.value} data-suffix={stat.suffix}>
          <div
            class="counter-m font-display font-bold gradient-text leading-none mb-2"
            style="font-size:clamp(2.5rem,10vw,3.25rem);"
          >
            0{stat.suffix}
          </div>
          <p class="text-white/70 text-xs font-medium">{stat.label}</p>
        </div>
      ))}
    </div>

  </div>

  <!-- Bottom gradient line -->
  <div class="gradient-line"></div>

</section>

<script is:inline>
  function runCounters(counterClass, gridId) {
    document.querySelectorAll(gridId + ' [data-target]').forEach((item) => {
      const target  = parseInt(item.dataset.target, 10);
      const suffix  = item.dataset.suffix;
      const counter = item.querySelector('.' + counterClass);
      if (!counter) return;
      const obj = { val: 0 };
      gsap.to(obj, {
        val: target,
        duration: 2,
        ease: 'power2.out',
        onUpdate: () => { counter.textContent = Math.round(obj.val) + suffix; },
      });
    });
  }

  ScrollTrigger.create({
    trigger: '#stats-grid',
    start: 'top 85%',
    once: true,
    onEnter: () => runCounters('counter', '#stats-grid'),
  });

  ScrollTrigger.create({
    trigger: '#stats-grid-mobile',
    start: 'top 85%',
    once: true,
    onEnter: () => runCounters('counter-m', '#stats-grid-mobile'),
  });

  // Reveal
  gsap.from('#stats-grid .stat-item', {
    scrollTrigger: { trigger: '#stats-grid', start: 'top 85%' },
    opacity: 0, y: 30, duration: 0.7, stagger: 0.12, ease: 'power3.out',
  });
  gsap.from('#stats-grid-mobile .stat-item-mobile', {
    scrollTrigger: { trigger: '#stats-grid-mobile', start: 'top 85%' },
    opacity: 0, y: 20, duration: 0.6, stagger: 0.1, ease: 'power3.out',
  });
</script>
