---
const items = [
  'Веб-розробка', 'Мобільні додатки', 'PostgreSQL', 'REST API',
  'Кібербезпека', 'IT-консалтинг', 'Хостинг', 'Адміністрування серверів',
  'UI/UX дизайн', 'Брендбук', 'Макетування', 'Figma',
  'Аналітика даних', 'Бази даних', 'Автоматизація', 'Вебінари',
  'Тренінги', 'IT-аудит', 'Інформаційна безпека', 'Технічна підтримка',
];

// Дублюємо для безшовної петлі
const doubled = [...items, ...items];
---

<div class="marquee-wrapper py-6" style="background:var(--ticker-bg);border-top:1px solid var(--ticker-border);border-bottom:1px solid var(--ticker-border);">
  <div class="marquee-track">
    {doubled.map((item, i) => (
      <div class="flex items-center gap-8 px-4 select-none">
        <span class="text-brand-gray text-sm font-medium whitespace-nowrap hover:text-white transition-colors duration-200">
          {item}
        </span>
        <span class="w-1 h-1 rounded-full flex-shrink-0" style="background:linear-gradient(135deg,#3B82F6,#06B6D4);opacity:0.6;"></span>
      </div>
    ))}
  </div>
</div>
