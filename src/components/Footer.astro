---
const navLinks = [
  { label: 'Послуги',   href: '#services'  },
  { label: 'Процес',    href: '#process'   },
  { label: 'Портфоліо', href: '#portfolio' },
  { label: 'Контакти',  href: '#contact'   },
];

const services = [
  { label: 'Веб-додатки',      href: '#services' },
  { label: 'Лендінги',         href: '#services' },
  { label: 'Боти та автоматизація', href: '#services' },
  { label: 'API та інтеграції', href: '#services' },
];
---

<footer class="relative overflow-hidden" style="background:#060B15;">

  <!-- Ambient glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[300px] pointer-events-none opacity-[0.05]"
       style="background:radial-gradient(ellipse,#2563EB,transparent);filter:blur(80px);"></div>

  <!-- Top gradient line -->
  <div class="gradient-line"></div>

  <!-- ── Pre-footer CTA strip ── -->
  <div class="relative z-10 border-b" style="border-color:rgba(255,255,255,0.05);">
    <div class="max-w-7xl mx-auto px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <p class="text-white font-display font-bold text-xl md:text-2xl mb-1">
          Готові побудувати щось <span class="gradient-text">крутe?</span>
        </p>
        <p class="text-brand-gray text-sm">Відповімо протягом 24 годин з ідеями та кошторисом.</p>
      </div>
      <a href="#contact" class="btn-primary flex-shrink-0 w-full sm:w-auto justify-center">
        <span>Написати нам</span>
        <svg class="w-4 h-4 relative z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- ── Main footer grid ── -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 pt-14 pb-10">
    <div class="grid grid-cols-2 md:grid-cols-[2fr_1fr_1fr_1.2fr] gap-10 md:gap-8 mb-14">

      <!-- Brand col (full width on mobile) -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-5 group">
          <img src="/codewave_icon_transparent.svg" alt="CodeWave" class="h-9 w-auto transition-transform duration-300 group-hover:scale-110" />
          <span class="font-display font-bold text-xl">
            <span class="text-white">Code</span><span class="gradient-text">wave</span>
          </span>
        </a>
        <p class="text-brand-gray text-sm leading-relaxed max-w-xs mb-6">
          Розробляємо веб-додатки, лендінги та автоматизацію — від ідеї до живого продукту.
        </p>
        <!-- Social icons -->
        <div class="flex gap-2.5">
          <a href="#" aria-label="GitHub"
             class="w-9 h-9 rounded-xl border flex items-center justify-center transition-all duration-200"
             style="border-color:rgba(255,255,255,0.08);color:rgba(100,116,139,0.7);"
             onmouseenter="this.style.borderColor='rgba(59,130,246,0.4)';this.style.color='white';this.style.background='rgba(37,99,235,0.08)'"
             onmouseleave="this.style.borderColor='rgba(255,255,255,0.08)';this.style.color='rgba(100,116,139,0.7)';this.style.background=''">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a href="#" aria-label="LinkedIn"
             class="w-9 h-9 rounded-xl border flex items-center justify-center transition-all duration-200"
             style="border-color:rgba(255,255,255,0.08);color:rgba(100,116,139,0.7);"
             onmouseenter="this.style.borderColor='rgba(59,130,246,0.4)';this.style.color='white';this.style.background='rgba(37,99,235,0.08)'"
             onmouseleave="this.style.borderColor='rgba(255,255,255,0.08)';this.style.color='rgba(100,116,139,0.7)';this.style.background=''">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="https://t.me/codewave_studio" target="_blank" rel="noopener" aria-label="Telegram"
             class="w-9 h-9 rounded-xl border flex items-center justify-center transition-all duration-200"
             style="border-color:rgba(255,255,255,0.08);color:rgba(100,116,139,0.7);"
             onmouseenter="this.style.borderColor='rgba(6,182,212,0.4)';this.style.color='white';this.style.background='rgba(6,182,212,0.08)'"
             onmouseleave="this.style.borderColor='rgba(255,255,255,0.08)';this.style.color='rgba(100,116,139,0.7)';this.style.background=''">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="text-white font-semibold text-xs uppercase tracking-[0.15em] mb-5">Навігація</h4>
        <ul class="flex flex-col gap-3">
          {navLinks.map((link) => (
            <li>
              <a href={link.href}
                 class="text-brand-gray text-sm transition-colors duration-200 flex items-center gap-2 group"
                 style="">
                <span class="w-0 group-hover:w-3 h-px transition-all duration-300 flex-shrink-0"
                      style="background:linear-gradient(90deg,#2563EB,#06B6D4);"></span>
                <span class="group-hover:text-white transition-colors duration-200">{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-white font-semibold text-xs uppercase tracking-[0.15em] mb-5">Послуги</h4>
        <ul class="flex flex-col gap-3">
          {services.map((s) => (
            <li>
              <a href={s.href}
                 class="text-brand-gray text-sm transition-colors duration-200 flex items-center gap-2 group">
                <span class="w-0 group-hover:w-3 h-px transition-all duration-300 flex-shrink-0"
                      style="background:linear-gradient(90deg,#06B6D4,#2563EB);"></span>
                <span class="group-hover:text-white transition-colors duration-200">{s.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contacts -->
      <div>
        <h4 class="text-white font-semibold text-xs uppercase tracking-[0.15em] mb-5">Контакти</h4>
        <div class="flex flex-col gap-3">
          <a href="mailto:hello@codewave.studio"
             class="flex items-center gap-3 p-3 rounded-xl transition-all duration-200 group"
             style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);"
             onmouseenter="this.style.borderColor='rgba(37,99,235,0.3)';this.style.background='rgba(37,99,235,0.05)'"
             onmouseleave="this.style.borderColor='rgba(255,255,255,0.06)';this.style.background='rgba(255,255,255,0.02)'">
            <div class="w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0"
                 style="background:linear-gradient(135deg,#2563EB,#06B6D4);">
              <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
              </svg>
            </div>
            <span class="text-brand-gray text-sm group-hover:text-white transition-colors duration-200">hello@codewave.studio</span>
          </a>

          <a href="https://t.me/codewave_studio" target="_blank" rel="noopener"
             class="flex items-center gap-3 p-3 rounded-xl transition-all duration-200 group"
             style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);"
             onmouseenter="this.style.borderColor='rgba(6,182,212,0.3)';this.style.background='rgba(6,182,212,0.05)'"
             onmouseleave="this.style.borderColor='rgba(255,255,255,0.06)';this.style.background='rgba(255,255,255,0.02)'">
            <div class="w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0"
                 style="background:linear-gradient(135deg,#2563EB,#06B6D4);">
              <svg class="w-3.5 h-3.5 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"/>
              </svg>
            </div>
            <span class="text-brand-gray text-sm group-hover:text-white transition-colors duration-200">@codewave_studio</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="gradient-line mb-6"></div>
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-brand-gray text-sm">
        © {new Date().getFullYear()} CodeWave. Всі права захищено.
      </p>

      <!-- Made by badge -->
      <div class="flex items-center gap-2.5 px-4 py-2 rounded-full"
           style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);">
        <img src="/codewave_icon_transparent.svg" alt="CodeWave" class="w-5 h-5 flex-shrink-0" />
        <span class="text-xs" style="color:rgba(100,116,139,0.7);">Розроблено командою</span>
        <span class="font-display font-bold text-xs gradient-text">CodeWave</span>
        <span class="w-1.5 h-1.5 rounded-full bg-brand-cyan animate-pulse flex-shrink-0"></span>
      </div>
    </div>

  </div>
</footer>
