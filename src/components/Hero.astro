---
---

<section id="hero" class="relative min-h-screen flex items-center overflow-hidden" style="background:var(--bg-hero);">

  <!-- Background layers -->
  <div class="absolute top-0 right-0 w-[900px] h-[800px] pointer-events-none opacity-[0.15]"
       style="background:radial-gradient(circle at 70% 25%,#2563EB,transparent 60%);filter:blur(120px);"></div>
  <div class="absolute bottom-0 left-0 w-[700px] h-[600px] pointer-events-none opacity-[0.10]"
       style="background:radial-gradient(circle at 30% 75%,#06B6D4,transparent 65%);filter:blur(100px);"></div>
  <div class="dot-grid absolute inset-0 pointer-events-none opacity-40"></div>
  <!-- Vignette -->
  <div class="absolute inset-0 pointer-events-none"
       style="background:radial-gradient(ellipse 90% 70% at 50% 50%,transparent 30%,rgba(8,14,26,0.25) 100%);"></div>

  <!-- Main container -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 pt-28 pb-20 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.1fr] gap-12 xl:gap-20 items-center">

      <!-- ── Left: text ── -->
      <div>
        <!-- Tag -->
        <div id="hero-tag" class="inline-flex items-center gap-2 tag-pill mb-8" style="opacity:0;transform:translateY(20px);">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-cyan animate-pulse"></span>
          IT-послуги · Україна
        </div>

        <!-- Headline -->
        <h1 id="hero-headline" class="font-display font-bold leading-[1.06] text-white mb-6"
            style="font-size:clamp(2.4rem,4.8vw,4rem);opacity:0;transform:translateY(40px);">
          Ваш бізнес з нами стає<br/>
          <span id="hero-word" class="gradient-text-hero">цифровим</span>
        </h1>

        <!-- Subtitle -->
        <p id="hero-sub" class="text-brand-gray text-lg leading-relaxed mb-10 max-w-lg"
           style="opacity:0;transform:translateY(25px);">
          Розробка, кібербезпека, IT-підтримка, дизайн та навчання&nbsp;—
          комплексні IT-рішення, що вирішують реальні задачі бізнесу.
        </p>

        <!-- CTAs -->
        <div id="hero-cta" class="flex flex-col sm:flex-row items-stretch sm:items-start gap-3 sm:gap-4 mb-10 sm:mb-12"
             style="opacity:0;transform:translateY(20px);">
          <a href="#contact" class="btn-primary w-full sm:w-auto justify-center">
            <span>Розпочати проєкт</span>
            <svg class="w-4 h-4 relative z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="#why-us" class="btn-secondary w-full sm:w-auto justify-center">
            Чому обирають нас
          </a>
        </div>

        <!-- Mobile visual — only shown on mobile (<lg) -->
        <div class="lg:hidden mt-8" id="hero-mobile-visual" style="opacity:0;transform:translateY(30px);">
          <!-- Mini network -->
          <div class="relative rounded-2xl overflow-hidden"
               style="height:260px;border:1px solid var(--border-md);background:var(--bg-network);box-shadow:0 20px 60px rgba(0,0,0,0.5);">

            <!-- Dot grid -->
            <div class="absolute inset-0 pointer-events-none"
                 style="background-image:radial-gradient(rgba(255,255,255,0.04) 1px,transparent 1px);background-size:24px 24px;"></div>

            <!-- Center glow -->
            <div class="absolute pointer-events-none"
                 style="left:50%;top:50%;transform:translate(-50%,-50%);width:200px;height:200px;background:radial-gradient(circle,rgba(37,99,235,0.1),transparent 70%);filter:blur(20px);"></div>

            <!-- SVG lines -->
            <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 360 260" preserveAspectRatio="xMidYMid meet">
              <line x1="180" y1="130" x2="60"  y2="48"  stroke="#2563EB" stroke-opacity="0.25" stroke-width="1" stroke-dasharray="5 4"/>
              <line x1="180" y1="130" x2="300" y2="48"  stroke="#0891B2" stroke-opacity="0.25" stroke-width="1" stroke-dasharray="5 4"/>
              <line x1="180" y1="130" x2="330" y2="150" stroke="#DC2626" stroke-opacity="0.2"  stroke-width="1" stroke-dasharray="5 4"/>
              <line x1="180" y1="130" x2="270" y2="218" stroke="#06B6D4" stroke-opacity="0.25" stroke-width="1" stroke-dasharray="5 4"/>
              <line x1="180" y1="130" x2="90"  y2="218" stroke="#10B981" stroke-opacity="0.25" stroke-width="1" stroke-dasharray="5 4"/>
              <line x1="180" y1="130" x2="30"  y2="150" stroke="#7C3AED" stroke-opacity="0.25" stroke-width="1" stroke-dasharray="5 4"/>
            </svg>

            <!-- Hub -->
            <div class="absolute" style="left:50%;top:50%;transform:translate(-50%,-50%);">
              <div class="w-14 h-14 rounded-2xl flex items-center justify-center"
                   style="background:linear-gradient(135deg,#1e3a8a,#1e40af);border:1px solid rgba(96,165,250,0.5);box-shadow:0 0 28px rgba(37,99,235,0.5);">
                <img src="/codewave_icon_transparent.svg" alt="CodeWave" class="w-9 h-9"/>
              </div>
            </div>

            <!-- Nodes -->
            {[
              { label: 'Розробка',     x: '16.7%', y: '18.5%', c: '#2563EB', icon: 'M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5' },
              { label: 'IT-підтримка', x: '83.3%', y: '18.5%', c: '#0891B2', icon: 'M21.75 17.25v.75a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25v-.75M12 3v13.5m0 0l-3-3m3 3l3-3' },
              { label: 'Безпека',      x: '91.7%', y: '57.7%', c: '#DC2626', icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z' },
              { label: 'Навчання',     x: '75%',   y: '83.8%', c: '#06B6D4', icon: 'M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489' },
              { label: 'Аналітика',    x: '25%',   y: '83.8%', c: '#10B981', icon: 'M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z' },
              { label: 'Дизайн',       x: '8.3%',  y: '57.7%', c: '#7C3AED', icon: 'M4.098 19.902a3.75 3.75 0 005.304 0l6.401-6.402M6.75 21A3.75 3.75 0 013 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 003.75-3.75V8.197M6.75 17.25h.008v.008H6.75v-.008z' },
            ].map(({ label, x, y, c, icon }) => (
              <div class="absolute flex flex-col items-center" style={`left:${x};top:${y};transform:translate(-50%,-50%);`}>
                <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-1"
                     style={`background:${c}18;border:1px solid ${c}44;box-shadow:0 0 14px ${c}22;`}>
                  <svg class="w-4 h-4" style={`color:${c};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d={icon}/>
                  </svg>
                </div>
                <p style={`font-size:7px;color:rgba(148,163,184,0.6);white-space:nowrap;`}>{label}</p>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- ── Right: Product mockup ── -->
      <div id="hero-mockup" class="hidden lg:block relative" style="opacity:0;transform:translateY(30px);">

        <!-- Glow behind mockup -->
        <div class="absolute inset-0 rounded-3xl pointer-events-none"
             style="background:radial-gradient(ellipse at 50% 50%,rgba(37,99,235,0.12),transparent 70%);filter:blur(40px);transform:scale(1.1);"></div>

        <!-- Network visualization -->
        <div class="relative rounded-2xl overflow-hidden" id="network-container"
             style="height:400px;border:1px solid var(--border-md);background:var(--bg-network);box-shadow:0 40px 120px rgba(0,0,0,0.65);">

          <!-- Dot grid -->
          <div class="absolute inset-0 pointer-events-none"
               style="background-image:radial-gradient(rgba(255,255,255,0.035) 1px,transparent 1px);background-size:28px 28px;"></div>

          <!-- Center ambient glow -->
          <div class="absolute pointer-events-none"
               style="left:50%;top:46%;transform:translate(-50%,-50%);width:300px;height:300px;background:radial-gradient(circle,rgba(37,99,235,0.1),transparent 70%);filter:blur(30px);"></div>

          <!-- SVG lines -->
          <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 500 400" preserveAspectRatio="xMidYMid meet" id="net-svg">
            <defs>
              <marker id="dot" markerWidth="4" markerHeight="4" refX="2" refY="2">
                <circle cx="2" cy="2" r="1.5" fill="rgba(59,130,246,0.6)"/>
              </marker>
            </defs>
            <line x1="250" y1="185" x2="88"  y2="70"  stroke="#2563EB" stroke-opacity="0.28" stroke-width="1.2" stroke-dasharray="6 5"/>
            <line x1="250" y1="185" x2="430" y2="75"  stroke="#0891B2" stroke-opacity="0.28" stroke-width="1.2" stroke-dasharray="6 5"/>
            <line x1="250" y1="185" x2="455" y2="230" stroke="#DC2626" stroke-opacity="0.22" stroke-width="1.2" stroke-dasharray="6 5"/>
            <line x1="250" y1="185" x2="310" y2="338" stroke="#06B6D4" stroke-opacity="0.28" stroke-width="1.2" stroke-dasharray="6 5"/>
            <line x1="250" y1="185" x2="130" y2="338" stroke="#10B981" stroke-opacity="0.28" stroke-width="1.2" stroke-dasharray="6 5"/>
            <line x1="250" y1="185" x2="45"  y2="225" stroke="#7C3AED" stroke-opacity="0.28" stroke-width="1.2" stroke-dasharray="6 5"/>
          </svg>

          <!-- Hub — center -->
          <div class="net-node absolute" style="left:50%;top:46.3%;transform:translate(-50%,-50%);">
            <div class="absolute rounded-full pointer-events-none" style="inset:-18px;background:rgba(37,99,235,0.08);"></div>
            <div class="absolute rounded-full pointer-events-none" style="inset:-10px;background:rgba(37,99,235,0.06);"></div>
            <div class="w-16 h-16 rounded-2xl flex items-center justify-center relative z-10"
                 style="background:linear-gradient(135deg,#1e3a8a,#1e40af);border:1px solid rgba(96,165,250,0.5);box-shadow:0 0 36px rgba(37,99,235,0.55);">
              <img src="/codewave_icon_transparent.svg" alt="CodeWave" class="w-10 h-10"/>
            </div>
          </div>

          <!-- Node 1: Розробка — top left -->
          <div class="net-node absolute" style="left:17.6%;top:17.5%;transform:translate(-50%,-50%);">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-1.5"
                 style="background:rgba(37,99,235,0.14);border:1px solid rgba(37,99,235,0.45);box-shadow:0 0 22px rgba(37,99,235,0.22);">
              <svg class="w-6 h-6" style="color:#60A5FA;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/>
              </svg>
            </div>
            <p class="text-center" style="font-size:9px;color:rgba(148,163,184,0.65);white-space:nowrap;">Розробка</p>
          </div>

          <!-- Node 2: IT-підтримка — top right -->
          <div class="net-node absolute" style="left:86%;top:18.8%;transform:translate(-50%,-50%);">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-1.5"
                 style="background:rgba(8,145,178,0.14);border:1px solid rgba(8,145,178,0.45);box-shadow:0 0 22px rgba(8,145,178,0.22);">
              <svg class="w-6 h-6" style="color:#38BDF8;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 17.25v.75a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25v-.75M12 3v13.5m0 0l-3-3m3 3l3-3"/>
              </svg>
            </div>
            <p class="text-center" style="font-size:9px;color:rgba(148,163,184,0.65);white-space:nowrap;">IT-підтримка</p>
          </div>

          <!-- Node 3: Кібербезпека — right -->
          <div class="net-node absolute" style="left:91%;top:57.5%;transform:translate(-50%,-50%);">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-1.5"
                 style="background:rgba(220,38,38,0.12);border:1px solid rgba(220,38,38,0.42);box-shadow:0 0 22px rgba(220,38,38,0.2);">
              <svg class="w-6 h-6" style="color:#F87171;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
              </svg>
            </div>
            <p class="text-center" style="font-size:9px;color:rgba(148,163,184,0.65);white-space:nowrap;">Кібербезпека</p>
          </div>

          <!-- Node 4: Навчання — bottom right -->
          <div class="net-node absolute" style="left:62%;top:84.5%;transform:translate(-50%,-50%);">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-1.5"
                 style="background:rgba(6,182,212,0.12);border:1px solid rgba(6,182,212,0.42);box-shadow:0 0 22px rgba(6,182,212,0.2);">
              <svg class="w-6 h-6" style="color:#67E8F9;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489"/>
              </svg>
            </div>
            <p class="text-center" style="font-size:9px;color:rgba(148,163,184,0.65);white-space:nowrap;">Навчання</p>
          </div>

          <!-- Node 5: Аналітика — bottom left -->
          <div class="net-node absolute" style="left:26%;top:84.5%;transform:translate(-50%,-50%);">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-1.5"
                 style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.42);box-shadow:0 0 22px rgba(16,185,129,0.2);">
              <svg class="w-6 h-6" style="color:#6EE7B7;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>
              </svg>
            </div>
            <p class="text-center" style="font-size:9px;color:rgba(148,163,184,0.65);white-space:nowrap;">Аналітика</p>
          </div>

          <!-- Node 6: Дизайн — left -->
          <div class="net-node absolute" style="left:9%;top:56.3%;transform:translate(-50%,-50%);">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-1.5"
                 style="background:rgba(124,58,237,0.12);border:1px solid rgba(124,58,237,0.42);box-shadow:0 0 22px rgba(124,58,237,0.2);">
              <svg class="w-6 h-6" style="color:#C4B5FD;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.098 19.902a3.75 3.75 0 005.304 0l6.401-6.402M6.75 21A3.75 3.75 0 013 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 003.75-3.75V8.197M6.75 17.25h.008v.008H6.75v-.008z"/>
              </svg>
            </div>
            <p class="text-center" style="font-size:9px;color:rgba(148,163,184,0.65);white-space:nowrap;">Дизайн</p>
          </div>

        </div>

        <!-- Floating badges -->

        <!-- Support badge — bottom right -->
        <div id="badge-deploy" class="absolute rounded-2xl px-3.5 py-2.5 flex items-center gap-2.5"
             style="bottom:-16px;right:-16px;background:var(--bg-2);border:1px solid var(--border-md);box-shadow:0 8px 40px rgba(0,0,0,0.5);opacity:0;">
          <div class="w-7 h-7 rounded-xl flex items-center justify-center flex-shrink-0"
               style="background:rgba(37,99,235,0.15);border:1px solid rgba(37,99,235,0.25);">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
                 style="color:#60A5FA;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-white text-xs font-semibold leading-none mb-0.5">Підтримка 24/7</p>
            <p style="font-size:10px;color:rgba(100,116,139,0.8);">IT · Безпека · Адмін</p>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-brand-gray/50">
    <span class="text-xs tracking-widest uppercase">Scroll</span>
    <div class="w-px h-10 mt-1" style="background:linear-gradient(180deg,rgba(59,130,246,0.6),transparent)"></div>
  </div>

</section>

<script is:inline>
  // ── Entrance timeline ──────────────────────────────────────
  const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

  tl.to('#hero-tag',      { opacity:1, y:0, duration:0.7 })
    .to('#hero-headline', { opacity:1, y:0, duration:0.85 }, '-=0.4')
    .to('#hero-sub',      { opacity:1, y:0, duration:0.7  }, '-=0.45')
    .to('#hero-cta',      { opacity:1, y:0, duration:0.65 }, '-=0.4')
    .to('#hero-mobile-visual', { opacity:1, y:0, duration:0.8, ease:'power2.out' }, '-=0.3')
    .to('#hero-mockup',   { opacity:1, y:0, duration:1,   ease:'power2.out' }, '-=0.5')
    .to('#badge-deploy', {
        opacity: 1,
        scale: 1,
        duration: 0.7,
        ease: 'back.out(1.6)',
        from: { scale: 0.8 },
      }, '-=0.4');

  // ── Float network nodes ────────────────────────────────────
  document.querySelectorAll('.net-node').forEach((node, i) => {
    gsap.to(node, {
      y: (i % 2 === 0 ? -8 : 8),
      duration: 3 + i * 0.4,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
      delay: i * 0.3,
    });
  });

  // ── Word cycling ───────────────────────────────────────────
  const words = ['цифровим', 'захищеним', 'ефективним', 'сучасним'];
  let idx = 0;
  const wordEl = document.getElementById('hero-word');

  setInterval(() => {
    idx = (idx + 1) % words.length;
    gsap.to(wordEl, {
      opacity: 0, y: -12, duration: 0.35, ease: 'power2.in',
      onComplete: () => {
        wordEl.textContent = words[idx];
        gsap.fromTo(wordEl, { opacity:0, y:14 }, { opacity:1, y:0, duration:0.45, ease:'power2.out' });
      },
    });
  }, 2800);
</script>
