---
---

<section id="services" class="section-padding relative overflow-hidden" style="background:var(--bg-2);">

  <div class="absolute top-0 right-0 w-[500px] h-[500px] rounded-full opacity-[0.05] pointer-events-none"
       style="background:radial-gradient(circle,#2563EB,transparent);filter:blur(90px);"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14 gsap-reveal">
      <div>
        <div class="tag-pill mb-5">Що ми пропонуємо</div>
        <h2 class="font-display font-bold text-4xl md:text-5xl text-white">
          Наші <span class="gradient-text">послуги</span>
        </h2>
      </div>
      <p class="text-brand-gray text-base max-w-xs leading-relaxed md:text-right">
        Від розробки та безпеки до дизайну й навчання —<br class="hidden md:block"/> повний цикл IT-підтримки бізнесу.
      </p>
    </div>

    <!-- ══ Bento grid ══ -->
    <div class="flex lg:grid lg:grid-cols-4 overflow-x-auto lg:overflow-visible snap-x lg:snap-none snap-mandatory pb-4 lg:pb-0 gap-4 lg:gap-3 -mx-6 lg:mx-0 px-6 lg:px-0" id="services-bento">

      <!-- ━━ 1. Розробка (large, col-span-2) ━━ -->
      <div class="service-bento-card flex-shrink-0 lg:flex-shrink snap-start w-[85vw] sm:w-[70vw] lg:w-auto lg:col-span-2 rounded-3xl overflow-hidden group relative"
           style="opacity:0;transform:translateY(40px);background:var(--surface);border:1px solid var(--border);">
        <div class="absolute top-0 left-0 right-0 h-[2px]"
             style="background:linear-gradient(90deg,#2563EB,#06B6D4);"></div>
        <div class="relative h-48 overflow-hidden flex items-center justify-center"
             style="background:linear-gradient(135deg,rgba(37,99,235,0.08) 0%,rgba(6,182,212,0.04) 100%);">
          <div class="absolute w-60 h-60 rounded-full" style="border:1px solid rgba(37,99,235,0.1);"></div>
          <div class="absolute w-40 h-40 rounded-full" style="border:1px solid rgba(37,99,235,0.15);"></div>
          <div class="absolute w-36 h-36 rounded-full" style="background:radial-gradient(circle,rgba(37,99,235,0.18),transparent);filter:blur(20px);"></div>
          <div class="relative w-20 h-20 rounded-2xl flex items-center justify-center"
               style="background:linear-gradient(135deg,#1e3a8a,#1e40af);border:1px solid rgba(59,130,246,0.4);box-shadow:0 0 40px rgba(37,99,235,0.35);">
            <svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/>
            </svg>
          </div>
          <div class="absolute top-6 right-8 px-3 py-1.5 rounded-full text-xs font-medium"
               style="background:rgba(37,99,235,0.15);border:1px solid rgba(37,99,235,0.3);color:#93C5FD;">Веб / Мобайл</div>
          <div class="absolute bottom-8 left-6 px-3 py-1.5 rounded-full text-xs font-medium"
               style="background:rgba(6,182,212,0.12);border:1px solid rgba(6,182,212,0.3);color:#67E8F9;">Автоматизація</div>
          <div class="absolute top-8 left-8 px-3 py-1.5 rounded-full text-xs font-medium"
               style="background:rgba(37,99,235,0.1);border:1px solid rgba(37,99,235,0.25);color:#93C5FD;">Бази даних</div>
        </div>
        <div class="p-7 pt-5">
          <div class="flex items-start justify-between gap-4 mb-3">
            <h3 class="font-display font-bold text-2xl text-white group-hover:gradient-text transition-all duration-300">Розробка ПЗ та додатків</h3>
            <div class="flex flex-wrap gap-1.5 mt-1 justify-end">
              {['Веб-додатки','Мобайл','БД','API','Автоматизація'].map(t => (
                <span class="text-xs px-2.5 py-1 rounded-full font-medium"
                      style="background:rgba(37,99,235,0.1);border:1px solid rgba(37,99,235,0.2);color:#93C5FD;">{t}</span>
              ))}
            </div>
          </div>
          <p class="text-brand-gray text-sm leading-relaxed">
            Проєктування, розробка, тестування, верстка та інтеграція веб- і мобільних додатків, веб-порталів, баз даних та систем автоматизації — від ідеї до готового продукту.
          </p>
        </div>
      </div>

      <!-- ━━ 2. IT-підтримка та адміністрування (small) ━━ -->
      <div class="service-bento-card flex-shrink-0 lg:flex-shrink snap-start w-[85vw] sm:w-[70vw] lg:w-auto rounded-3xl overflow-hidden group relative"
           style="opacity:0;transform:translateY(40px);background:var(--surface);border:1px solid var(--border);">
        <div class="absolute top-0 left-0 right-0 h-[2px]"
             style="background:linear-gradient(90deg,#0891B2,#06B6D4);"></div>
        <div class="relative h-48 overflow-hidden flex items-center justify-center"
             style="background:linear-gradient(135deg,rgba(8,145,178,0.08) 0%,rgba(6,182,212,0.04) 100%);">
          <div class="absolute w-60 h-60 rounded-full" style="border:1px solid rgba(8,145,178,0.1);"></div>
          <div class="absolute w-40 h-40 rounded-full" style="border:1px solid rgba(8,145,178,0.15);"></div>
          <div class="absolute w-36 h-36 rounded-full" style="background:radial-gradient(circle,rgba(8,145,178,0.18),transparent);filter:blur(20px);"></div>
          <div class="relative w-20 h-20 rounded-2xl flex items-center justify-center"
               style="background:linear-gradient(135deg,#0c4a6e,#075985);border:1px solid rgba(56,189,248,0.4);box-shadow:0 0 40px rgba(8,145,178,0.3);">
            <svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 17.25v.75a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25v-.75M12 12.75H12m-.75 3h1.5M3 9.375h18M3 12.75h18M5.25 6.75h.008v.008H5.25V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM8.25 6.75h.008v.008H8.25V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM11.25 6.75h.008v.008h-.008V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/>
            </svg>
          </div>
          <div class="absolute top-6 right-6 px-2.5 py-1 rounded-full text-xs font-medium"
               style="background:rgba(8,145,178,0.15);border:1px solid rgba(8,145,178,0.3);color:#7DD3FC;">Сервери</div>
          <div class="absolute bottom-8 left-5 px-2.5 py-1 rounded-full text-xs font-medium"
               style="background:rgba(6,182,212,0.12);border:1px solid rgba(6,182,212,0.3);color:#67E8F9;">Хостинг</div>
        </div>
        <div class="p-6 pt-4">
          <h3 class="font-display font-bold text-xl text-white mb-2 group-hover:gradient-text transition-all duration-300">IT-підтримка та адміністрування</h3>
          <p class="text-brand-gray text-sm leading-relaxed mb-4">
            Технічна підтримка, адміністрування серверів, БД та мереж, хостинг, налаштування засобів захисту даних і політик доступу.
          </p>
          <div class="flex flex-wrap gap-1.5">
            {['Сервери','Мережі','Хостинг'].map(t => (
              <span class="text-xs px-2.5 py-1 rounded-full"
                    style="background:rgba(8,145,178,0.08);border:1px solid rgba(8,145,178,0.22);color:#7DD3FC;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <!-- ━━ 3. Кібербезпека та IT-консалтинг (small) ━━ -->
      <div class="service-bento-card flex-shrink-0 lg:flex-shrink snap-start w-[85vw] sm:w-[70vw] lg:w-auto rounded-3xl overflow-hidden group relative"
           style="opacity:0;transform:translateY(40px);background:var(--surface);border:1px solid var(--border);">
        <div class="absolute top-0 left-0 right-0 h-[2px]"
             style="background:linear-gradient(90deg,#DC2626,#F97316);"></div>
        <div class="relative h-48 overflow-hidden flex items-center justify-center"
             style="background:linear-gradient(135deg,rgba(220,38,38,0.07) 0%,rgba(249,115,22,0.04) 100%);">
          <div class="absolute w-60 h-60 rounded-full" style="border:1px solid rgba(220,38,38,0.1);"></div>
          <div class="absolute w-40 h-40 rounded-full" style="border:1px solid rgba(220,38,38,0.14);"></div>
          <div class="absolute w-36 h-36 rounded-full" style="background:radial-gradient(circle,rgba(220,38,38,0.15),transparent);filter:blur(20px);"></div>
          <div class="relative w-20 h-20 rounded-2xl flex items-center justify-center"
               style="background:linear-gradient(135deg,#7f1d1d,#991b1b);border:1px solid rgba(248,113,113,0.4);box-shadow:0 0 40px rgba(220,38,38,0.25);">
            <svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
            </svg>
          </div>
          <div class="absolute top-6 right-6 px-2.5 py-1 rounded-full text-xs font-medium"
               style="background:rgba(220,38,38,0.12);border:1px solid rgba(220,38,38,0.28);color:#FCA5A5;">Безпека</div>
          <div class="absolute bottom-8 left-5 px-2.5 py-1 rounded-full text-xs font-medium"
               style="background:rgba(249,115,22,0.1);border:1px solid rgba(249,115,22,0.28);color:#FDBA74;">IT-аудит</div>
        </div>
        <div class="p-6 pt-4">
          <h3 class="font-display font-bold text-xl text-white mb-2 group-hover:gradient-text transition-all duration-300">Кібербезпека та IT-консалтинг</h3>
          <p class="text-brand-gray text-sm leading-relaxed mb-4">
            Аналіз IT-процесів, оцінка ризиків витоку інформації, рекомендації щодо інформаційної безпеки та управління IT-ресурсами.
          </p>
          <div class="flex flex-wrap gap-1.5">
            {['Безпека','IT-аудит','Консалтинг'].map(t => (
              <span class="text-xs px-2.5 py-1 rounded-full"
                    style="background:rgba(220,38,38,0.08);border:1px solid rgba(220,38,38,0.2);color:#FCA5A5;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <!-- ━━ 4. Дизайн та брендинг (small) ━━ -->
      <div class="service-bento-card flex-shrink-0 lg:flex-shrink snap-start w-[85vw] sm:w-[70vw] lg:w-auto rounded-3xl overflow-hidden group relative"
           style="opacity:0;transform:translateY(40px);background:var(--surface);border:1px solid var(--border);">
        <div class="absolute top-0 left-0 right-0 h-[2px]"
             style="background:linear-gradient(90deg,#7C3AED,#2563EB);"></div>
        <div class="relative h-48 overflow-hidden flex items-center justify-center"
             style="background:linear-gradient(135deg,rgba(124,58,237,0.08) 0%,rgba(37,99,235,0.04) 100%);">
          <div class="absolute w-60 h-60 rounded-full" style="border:1px solid rgba(124,58,237,0.1);"></div>
          <div class="absolute w-40 h-40 rounded-full" style="border:1px solid rgba(124,58,237,0.15);"></div>
          <div class="absolute w-36 h-36 rounded-full" style="background:radial-gradient(circle,rgba(124,58,237,0.18),transparent);filter:blur(20px);"></div>
          <div class="relative w-20 h-20 rounded-2xl flex items-center justify-center"
               style="background:linear-gradient(135deg,#4c1d95,#6d28d9);border:1px solid rgba(167,139,250,0.4);box-shadow:0 0 40px rgba(124,58,237,0.3);">
            <svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.098 19.902a3.75 3.75 0 005.304 0l6.401-6.402M6.75 21A3.75 3.75 0 013 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 003.75-3.75V8.197M6.75 17.25h.008v.008H6.75v-.008z"/>
            </svg>
          </div>
          <div class="absolute top-6 right-6 px-2.5 py-1 rounded-full text-xs font-medium"
               style="background:rgba(124,58,237,0.15);border:1px solid rgba(124,58,237,0.3);color:#C4B5FD;">UI/UX</div>
          <div class="absolute bottom-8 left-5 px-2.5 py-1 rounded-full text-xs font-medium"
               style="background:rgba(37,99,235,0.12);border:1px solid rgba(37,99,235,0.3);color:#93C5FD;">Брендбук</div>
        </div>
        <div class="p-6 pt-4">
          <h3 class="font-display font-bold text-xl text-white mb-2 group-hover:gradient-text transition-all duration-300">Дизайн та брендинг</h3>
          <p class="text-brand-gray text-sm leading-relaxed mb-4">
            Графічне оформлення, UI/UX концепції, візуальний стиль, брендбуки та макетування продуктів замовника.
          </p>
          <div class="flex flex-wrap gap-1.5">
            {['UI/UX','Брендбук','Макети'].map(t => (
              <span class="text-xs px-2.5 py-1 rounded-full"
                    style="background:rgba(124,58,237,0.08);border:1px solid rgba(124,58,237,0.22);color:#C4B5FD;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <!-- ━━ 5. Аналітика та дані (small) ━━ -->
      <div class="service-bento-card flex-shrink-0 lg:flex-shrink snap-start w-[85vw] sm:w-[70vw] lg:w-auto rounded-3xl overflow-hidden group relative"
           style="opacity:0;transform:translateY(40px);background:var(--surface);border:1px solid var(--border);">
        <div class="absolute top-0 left-0 right-0 h-[2px]"
             style="background:linear-gradient(90deg,#10B981,#06B6D4);"></div>
        <div class="relative h-48 overflow-hidden flex items-center justify-center"
             style="background:linear-gradient(135deg,rgba(16,185,129,0.08) 0%,rgba(6,182,212,0.04) 100%);">
          <div class="absolute w-60 h-60 rounded-full" style="border:1px solid rgba(16,185,129,0.1);"></div>
          <div class="absolute w-40 h-40 rounded-full" style="border:1px solid rgba(16,185,129,0.15);"></div>
          <div class="absolute w-36 h-36 rounded-full" style="background:radial-gradient(circle,rgba(16,185,129,0.18),transparent);filter:blur(20px);"></div>
          <div class="relative w-20 h-20 rounded-2xl flex items-center justify-center"
               style="background:linear-gradient(135deg,#064e3b,#065f46);border:1px solid rgba(52,211,153,0.4);box-shadow:0 0 40px rgba(16,185,129,0.3);">
            <svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>
            </svg>
          </div>
          <div class="absolute top-6 right-6 px-2.5 py-1 rounded-full text-xs font-medium"
               style="background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.3);color:#6EE7B7;">Звіти</div>
          <div class="absolute bottom-8 left-5 px-2.5 py-1 rounded-full text-xs font-medium"
               style="background:rgba(6,182,212,0.12);border:1px solid rgba(6,182,212,0.3);color:#67E8F9;">Аналітика</div>
        </div>
        <div class="p-6 pt-4">
          <h3 class="font-display font-bold text-xl text-white mb-2 group-hover:gradient-text transition-all duration-300">Аналітика та дані</h3>
          <p class="text-brand-gray text-sm leading-relaxed mb-4">
            Збір, обробка, систематизація та надання інформаційних матеріалів, аналітичних довідок і даних за запитом.
          </p>
          <div class="flex flex-wrap gap-1.5">
            {['Звіти','Аналітика','Дані'].map(t => (
              <span class="text-xs px-2.5 py-1 rounded-full"
                    style="background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.22);color:#6EE7B7;">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <!-- ━━ 6. Навчання та консалтинг (large, col-span-2) ━━ -->
      <div class="service-bento-card flex-shrink-0 lg:flex-shrink snap-start w-[85vw] sm:w-[70vw] lg:w-auto lg:col-span-2 rounded-3xl overflow-hidden group relative"
           style="opacity:0;transform:translateY(40px);background:var(--surface);border:1px solid var(--border);">
        <div class="absolute top-0 left-0 right-0 h-[2px]"
             style="background:linear-gradient(90deg,#06B6D4,#2563EB);"></div>
        <div class="relative h-48 overflow-hidden flex items-center justify-center"
             style="background:linear-gradient(135deg,rgba(6,182,212,0.08) 0%,rgba(37,99,235,0.04) 100%);">
          <div class="absolute w-60 h-60 rounded-full" style="border:1px solid rgba(6,182,212,0.1);"></div>
          <div class="absolute w-40 h-40 rounded-full" style="border:1px solid rgba(6,182,212,0.15);"></div>
          <div class="absolute w-36 h-36 rounded-full" style="background:radial-gradient(circle,rgba(6,182,212,0.18),transparent);filter:blur(20px);"></div>
          <div class="relative w-20 h-20 rounded-2xl flex items-center justify-center"
               style="background:linear-gradient(135deg,#0e4f6b,#0e7490);border:1px solid rgba(34,211,238,0.4);box-shadow:0 0 40px rgba(6,182,212,0.3);">
            <svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/>
            </svg>
          </div>
          <div class="absolute top-6 right-10 px-3 py-1.5 rounded-full text-xs font-medium"
               style="background:rgba(6,182,212,0.15);border:1px solid rgba(6,182,212,0.3);color:#67E8F9;">Вебінари</div>
          <div class="absolute bottom-8 left-8 px-3 py-1.5 rounded-full text-xs font-medium"
               style="background:rgba(37,99,235,0.12);border:1px solid rgba(37,99,235,0.3);color:#93C5FD;">Тренінги</div>
          <div class="absolute top-8 left-10 px-3 py-1.5 rounded-full text-xs font-medium"
               style="background:rgba(6,182,212,0.1);border:1px solid rgba(6,182,212,0.25);color:#67E8F9;">Майстер-класи</div>
        </div>
        <div class="p-7 pt-5">
          <div class="flex items-start justify-between gap-4 mb-3">
            <h3 class="font-display font-bold text-2xl text-white group-hover:gradient-text transition-all duration-300">Навчання та консалтинг</h3>
            <div class="flex flex-wrap gap-1.5 mt-1 justify-end">
              {['Вебінари','Тренінги','Майстер-класи'].map(t => (
                <span class="text-xs px-2.5 py-1 rounded-full font-medium"
                      style="background:rgba(6,182,212,0.1);border:1px solid rgba(6,182,212,0.2);color:#67E8F9;">{t}</span>
              ))}
            </div>
          </div>
          <p class="text-brand-gray text-sm leading-relaxed">
            Навчальні тренінги, вебінари, майстер-класи та інструктажі — передаємо знання й надаємо навчально-консультаційний супровід для вашої команди.
          </p>
        </div>
      </div>

    </div>

    <!-- Swipe hint — mobile only -->
    <div class="flex lg:hidden items-center justify-center gap-2 mt-4 text-brand-gray/50">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
